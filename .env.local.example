# Copia este archivo a .env.local para probar en tu máquina con `npm run dev`.
# En Vercel, estas mismas variables se configuran en Settings > Environment Variables
# (las de Upstash se agregan solas al conectar la integración desde el Marketplace).

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ROOM_PASSWORD=cambia-esto-por-algo-largo-y-unico
